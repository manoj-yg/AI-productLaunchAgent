# FastAPI Environment Configuration
PORT=8000
BACKEND_HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Firebase Settings
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
GOOGLE_APPLICATION_CREDENTIALS=config/firebase-service-account.json

# Shopify Integration
SHOPIFY_SHOP_URL=your-shop-name.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_your_admin_access_token
SHOPIFY_API_VERSION=2024-04

# Google Gemini API
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# Model Context Protocol URL
MCP_SERVER_URLS=["http://localhost:5000/mcp"]
