# ==========================================
# AI Product Launch Platform Configuration
# ==========================================

# General Application Settings
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# FastAPI Backend Settings
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# React Frontend Settings
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Google Cloud Platform & Cloud Run Settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_SERVICE_ACCOUNT_KEY_JSON=your-base64-or-json-key-file

# Firebase Firestore & Storage Configuration (Backend)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# Path to Firebase Service Account Credentials JSON file
# For local dev, can be a relative path or absolute path
GOOGLE_APPLICATION_CREDENTIALS=config/firebase-service-account.json

# Shopify API Configuration
SHOPIFY_SHOP_URL=your-shop-name.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_your_admin_access_token
SHOPIFY_API_VERSION=2024-04

# Google Gemini AI Config (using new google-genai SDK)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash # or gemini-3.5-flash as specified

# Model Context Protocol (MCP) Configuration
MCP_SERVER_URLS=["http://localhost:5000/mcp"]
